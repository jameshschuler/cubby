    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "dev": "expo run:ios",
    "dev:ios": "expo run:ios",
    "device:ios": "expo run:ios --device",
    "clean": "npx expo prebuild --clean",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "eas:whoami": "npx eas-cli whoami",
    "eas:build:ios": "npx eas-cli build --platform ios --profile production",
    "eas:build:ios:local": "npx eas-cli build --platform ios --profile production --local",
    "eas:submit:ios": "npx eas-cli submit --platform ios --latest",
    "release:ios": "npm run eas:build:ios && npm run eas:submit:ios"
  },
  "private": true
