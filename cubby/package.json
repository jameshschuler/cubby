    "@vitest/coverage-v8": "^3.2.7",
    "babel-preset-expo": "^57.0.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
